{
  "manifest_version": 3,
  "name": "SetTopBox",
  "version": "1.0.0",
  "description": "Load every video in a YouTube playlist by progressively scrolling the playlist.",
  "developer": {
    "name": "Varun Pius Rodrigues"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-playlist-loader@local"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/playlist*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
